---
import Layout from "../layouts/Layout.astro";

const title = "ページが見つかりません｜BAN MAI SMART";
const description = "お探しのページは見つかりませんでした。BAN MAI SMART のトップページへお戻りください。";
---

<Layout title={title} description={description} noindex>
  <main class="not-found" id="main">
    <p class="kicker">404</p>
    <h1>ページが見つかりません</h1>
    <p>ご指定のページは移動または削除された可能性があります。</p>
    <a href="/">トップページへ戻る</a>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    width: min(720px, calc(100% - 40px));
    margin-inline: auto;
    padding: 120px 0;
  }

  h1 {
    margin-top: 16px;
    font-family: var(--font-jp);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  p {
    margin-top: 16px;
    color: var(--mute);
  }

  a {
    margin-top: 32px;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-size: 13px;
    letter-spacing: 0.12em;
  }
</style>
