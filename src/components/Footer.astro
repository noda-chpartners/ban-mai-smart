---
import { Icon } from "astro-icon/components";
import { social } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-brand">BAN MAI SMART</p>
      <p class="footer-note">スマートフォンの販売・買取・修理</p>
      <a
        class="footer-social"
        href={social.facebook}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="simple-icons:facebook" class="footer-social-icon" aria-hidden="true" />
        Facebook
      </a>
    </div>
    <div>
      <p class="footer-label">Store</p>
      <address>
        <p>〒812-0011</p>
        <p>福岡市博多区博多駅前3-9-5</p>
        <p>チサンマンション第一博多 601・602</p>
      </address>
    </div>
    <div>
      <p class="footer-label">Contact</p>
      <p>
        <a href={social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
      </p>
      <p>10:00 – 20:00 / 年中無休</p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>運営：<a href="#company">AN TAM合同会社</a></p>
    <p>&copy; {new Date().getFullYear()} BAN MAI SMART</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 56px 0 28px;
    color: var(--mute-dark);
    background: #0d0b09;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--line-light);
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--cream);
    letter-spacing: 0.18em;
  }

  .footer-note {
    margin-top: 10px;
    font-size: 13px;
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--cream);
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  .footer-social:hover {
    color: var(--orange-soft);
  }

  .footer-social :global(svg) {
    width: 16px;
    height: 16px;
  }

  .footer-label {
    margin-bottom: 10px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dawn);
  }

  .footer-grid p,
  .footer-grid address {
    margin: 0;
    font-size: 13px;
    font-style: normal;
    line-height: 1.9;
  }

  .footer-grid a:hover,
  .footer-bottom a:hover {
    color: var(--cream);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 22px;
    font-size: 12px;
  }

  @media (max-width: 720px) {
    .footer-grid,
    .footer-bottom {
      grid-template-columns: 1fr;
      display: grid;
    }
  }
</style>
